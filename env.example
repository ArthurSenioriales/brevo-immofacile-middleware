# ─── À copier dans Scalingo > Environnement (ne jamais commiter ce fichier avec de vraies valeurs) ───

# URL complète de l'endpoint API ImmoFacile pour créer un lead
# Exemple : https://api.immofacile.com/v1/leads
IMMOFACILE_API_URL=https://api.immofacile.com/v1/leads

# Clé API fournie par ImmoFacile
IMMOFACILE_API_KEY=ta_cle_api_immofacile

# Secret partagé entre Brevo et ce middleware (invente une chaîne aléatoire longue)
# Exemple : openssl rand -hex 32
WEBHOOK_SECRET=un_secret_long_et_aleatoire
